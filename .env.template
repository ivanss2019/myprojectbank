# Скопируйте этот файл в .env и укажите свой ключ:
#   cp .env.template .env
#
# API_KEY — ключ доступа к Exchange Rates Data API (apilayer.com),
# используется модулем src.external_api для конвертации сумм
# транзакций в USD/EUR в рубли.
# Получить ключ: https://apilayer.com/marketplace/exchangerates_data-api
API_KEY=your_api_key_here

# Ключ Alpha Vantage для курсовой (цены акций в USD).
# Получить: https://www.alphavantage.co/support/#api-key
# Без ключа цены будут null, расчёты транзакций продолжат работать.
ALPHA_VANTAGE_API_KEY=
